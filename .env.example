# =========================================================
# Archivo de EJEMPLO de variables de entorno.
#
# Spring Boot NO lee automáticamente un archivo ".env": estas
# variables se definen como variables de entorno reales, ya sea
# en tu sistema operativo, en la configuración de ejecución de tu
# IDE (IntelliJ / Eclipse / VS Code), o en el panel del servicio
# de despliegue (Render, Railway, etc).
#
# Este archivo solo documenta qué variables existen; NO contiene
# valores reales ni contraseñas. Nunca subas tus valores reales
# a GitHub.
# =========================================================

# Ambiente activo: development | testing | production
APP_ENV=development

# --- Solo necesarias en el ambiente de PRODUCCIÓN ---
# Cadena de conexión JDBC a la base de datos MySQL de producción
# (la asigna el servicio de base de datos que elijas: Railway, Aiven,
# Clever Cloud, etc.)
DB_URL=jdbc:mysql://mysql-2a7d4ce8-samidl03-6bae.b.aivencloud.com:13572/defaultdb?useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# Puerto en el que arranca la aplicación (Render/Railway lo inyectan
# automáticamente; en local se puede dejar así o quitarlo)
PORT=8080
